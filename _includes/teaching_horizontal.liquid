<div class="col mb-4">
  <a href="{% if include.teaching.redirect %}{{ include.teaching.redirect }}{% else %}{{ include.teaching.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      <div class="row no-gutters">
        {% if include.teaching.img %}
          <div class="col-md-6">
            {% include figure.liquid loading="eager" path=include.teaching.img sizes="(min-width: 768px) 156px, 50vw" alt="course image" class="card-img" %}
          </div>
        {% endif %}
        <div class="{% if include.teaching.img %}col-md-6{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title">{{ include.teaching.title }}</h3>
            <p class="card-text">{{ include.teaching.description }}</p>
            <p class="card-meta">
              {{ include.teaching.institution }} – {{ include.teaching.role }}
            </p>
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
