<div class="col">
  <a href="{% if include.teaching.redirect %}{{ include.teaching.redirect }}{% else %}{{ include.teaching.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if include.teaching.img %}
        {%
          include figure.liquid
          loading="eager"
          path=include.teaching.img
          sizes="250px"
          alt="course image"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ include.teaching.title }}</h2>
        <p class="card-text">{{ include.teaching.description }}</p>
        <p class="card-meta">
         {{ include.teaching.role }}
        </p>
      </div>
    </div>
  </a>
</div>
